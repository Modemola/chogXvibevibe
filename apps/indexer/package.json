{
  "name": "@scout/indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Scout indexer CLI: migrate, ingest sources, snapshot SPARK, resolve and evaluate",
  "type": "module",
  "bin": {
    "scout": "./dist/cli.js"
  },
  "scripts": {
    "scout": "tsx --conditions=source src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@scout/core": "workspace:*",
    "@scout/db": "workspace:*",
    "@scout/sources": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
