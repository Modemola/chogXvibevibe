{
  "name": "@scout/web",
  "version": "0.1.0",
  "private": true,
  "description": "Graduation Scout web app and API",
  "type": "module",
  "scripts": {
    "deps": "pnpm --filter @scout/core --filter @scout/db --filter @scout/sources build",
    "dev": "pnpm deps && next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@scout/core": "workspace:*",
    "@scout/db": "workspace:*",
    "@scout/sources": "workspace:*",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "viem": "^2.57.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
